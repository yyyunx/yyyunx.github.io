---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { otherLocale, ui, type Locale } from '../lib/i18n';
interface Props {
  title: string;
  description: string;
  lang?: Locale;
  alternate: string;
  article?: boolean;
  noindex?: boolean;
}
const {
  title,
  description,
  lang = 'zh-tw',
  alternate,
  article = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname,
  Astro.site,
);
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-Hant'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111c2c" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang={lang === 'en' ? 'en' : 'zh-Hant'}
      href={canonical}
    />
    <link
      rel="alternate"
      hreflang={otherLocale(lang) === 'en' ? 'en' : 'zh-Hant'}
      href={new URL(alternate, Astro.site)}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="YunHsi Lee" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_TW'} />
    <meta property="og:image" content={new URL('/social.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="YunHsi Lee — Computer Science student. Projects, experiments & technical notes."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let theme = 'system';
        try {
          theme = localStorage.getItem('portfolio-theme') || 'system';
        } catch {}
        document.documentElement.dataset.theme = ['light', 'dark'].includes(
          theme,
        )
          ? theme
          : matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {ui[lang].skip}
    </a>
    <Header lang={lang} alternate={alternate} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
