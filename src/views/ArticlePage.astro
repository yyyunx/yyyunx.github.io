---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import { translationUrl } from '../lib/content';
import { ui, statuses, categories, pathFor, otherLocale } from '../lib/i18n';
import { profile } from '../data/portfolio';
interface Props {
  entry: CollectionEntry<'projects' | 'notes'>;
}
const { entry } = Astro.props;
const { data } = entry;
const lang = data.lang;
const en = lang === 'en';
const t = ui[lang];
const project = entry.collection === 'projects' ? entry.data : undefined;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout
  title={`${data.title} — YunHsi Lee`}
  description={data.description}
  lang={lang}
  alternate={await translationUrl(entry, otherLocale(lang))}
  article
>
  <div class="shell article-shell">
    <a class="back-link" href={pathFor(lang, entry.collection)}>
      {project ? t.backProjects : t.backNotes}
    </a>
    <header class="article-heading">
      <p class="eyebrow">
        {project ? categories[project.category][lang] : data.category}
      </p>
      <h1>{data.title}</h1>
      <p class="article-description">{data.description}</p>
      {profile.participation
        .filter(
          (event) =>
            entry.collection === 'projects' &&
            event.project === data.translationKey,
        )
        .map((event) => (
          <p class="participation">
            {event.role} — {event.event}
          </p>
        ))}
      <div class="article-metadata">
        {project && (
          <span class="status">{statuses[project.status][lang]}</span>
        )}
        {data.pubDate && (
          <time datetime={data.pubDate.toISOString()}>
            {new Intl.DateTimeFormat(en ? 'en' : 'zh-TW', {
              dateStyle: 'long',
              timeZone: 'Asia/Taipei',
            }).format(data.pubDate)}
          </time>
        )}
        {project && (
          <>
            <span>{project.license}</span>
            <span>
              {en ? 'Sources reviewed' : '資料查核'}{' '}
              {project.reviewed.toISOString().slice(0, 10)}
            </span>
          </>
        )}
      </div>
      {data.tags.length > 0 && (
        <ul class="tags">
          {data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
      {project && (
        <div class="article-links">
          <a href={project.repository}>GitHub</a>
          {project.demo && <a href={project.demo}>Demo</a>}
        </div>
      )}
    </header>
    <div class="article-grid">
      <aside class="article-toc" aria-label={t.contents}>
        <p>{t.contents}</p>
        <ol>
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </aside>
      <article class="article-body">
        {project?.diagram && (
          <ArchitectureDiagram kind={project.diagram} lang={lang} />
        )}
        <Content />
        {project && (
          <section class="source-section" aria-labelledby="sources">
            <h2 id="sources">{t.evidence}</h2>
            <p>
              {en
                ? 'This project note summarizes the public repository at the revision linked below. Test results are attributed to those records; this website does not re-run the project’s model or system experiments.'
                : '本文依下列版本的公開程式與文件整理。實驗結果引用原專案紀錄；網站本身沒有重新執行模型或系統實驗。'}
            </p>
            <ul>
              {project.sources.map((source) => (
                <li>
                  <a href={source.url}>{source.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>
    </div>
  </div>
</BaseLayout>
