---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteCard from '../components/NoteCard.astro';
import { entries } from '../lib/content';
import { ui, pathFor, otherLocale, type Locale } from '../lib/i18n';
import { profile, researchInterests } from '../data/portfolio';
const { lang } = Astro.props as { lang: Locale };
const en = lang === 'en';
const projects = (await entries('projects', lang))
  .filter((p) => p.data.tier === 'featured')
  .slice(0, 4);
const notes = (await entries('notes', lang))
  .sort(
    (a, b) =>
      (b.data.pubDate?.getTime() || 0) - (a.data.pubDate?.getTime() || 0) ||
      a.data.order - b.data.order,
  )
  .slice(0, 3);
const t = ui[lang];
const description = en
  ? 'Computer Science student interested in computer architecture, digital hardware, and applied AI. Projects, experiments, and technical notes by YunHsi Lee.'
  : 'YunHsi Lee 的個人網站。資訊工程學生，關注電腦架構、數位硬體與人工智慧應用，記錄專案、實驗與技術學習。';
---

<BaseLayout
  title={`YunHsi Lee — ${en ? 'Projects & Technical Notes' : '專案與技術筆記'}`}
  description={description}
  lang={lang}
  alternate={pathFor(otherLocale(lang))}
>
  <div class="shell">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow">
          {en
            ? 'UNDERGRADUATE · COMPUTER SCIENCE AND ENGINEERING'
            : '資訊工程學士班學生'}
        </p>
        <h1 id="intro-title">{profile.name}</h1>
        <div class="hero-education" lang="en">
          <p class="education-name">{profile.education.university}</p>
          <p>{profile.education.department}</p>
          <p>{profile.education.program}</p>
          <p class="graduation">
            Expected Graduation: {profile.education.expectedGraduation.en}
          </p>
        </div>
        <p class="hero-intro">
          {en
            ? 'I’m interested in digital IC design, computer architecture, and hardware/software co-design. My project experience is in Linux systems programming, developer tools, and image processing.'
            : '對數位 IC 設計、電腦架構與軟硬體協同設計有興趣。目前的專案經驗以 Linux 系統程式、開發工具與影像處理為主。'}
        </p>
        <div class="hero-links">
          <a class="button" href={pathFor(lang, 'resume')}>
            Resume
          </a>
          <a class="quiet-link" href="#projects-title">
            {en ? 'Selected Projects' : '精選專案'}
          </a>
          <a class="quiet-link" href={profile.github}>
            GitHub
          </a>
        </div>
      </div>
      <aside class="interest-index" aria-labelledby="interest-title">
        <h2 class="eyebrow" id="interest-title">
          RESEARCH INTERESTS
        </h2>
        <ul class="interest-topics">
          {researchInterests.map((item) => (
            <li>{item.title}</li>
          ))}
        </ul>
        <p class="interest-scope">
          {en
            ? 'These are research interests. Verilog, RTL, FPGA, and RISC-V study and implementation have not started.'
            : '以上為研究興趣。Verilog、RTL、FPGA 與 RISC-V 尚未開始學習或實作。'}
        </p>
        <a class="index-link" href={pathFor(lang, 'research')}>
          {en ? 'Research interests & future directions' : '研究興趣與未來規劃'}
        </a>
      </aside>
    </section>
    <section class="honor-strip" aria-labelledby="home-honor">
      <p class="eyebrow">HONORS &amp; AWARDS</p>
      <h2 id="home-honor">
        {profile.honors[0].distinction} — {profile.honors[0].event}
      </h2>
    </section>
    <section class="home-projects" aria-labelledby="projects-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">SELECTED WORK</p>
          <h2 id="projects-title">{t.featured}</h2>
        </div>
        <a class="text-link" href={pathFor(lang, 'projects')}>
          {t.allProjects}
        </a>
      </div>
      <p class="section-intro">
        {en
          ? 'A few projects in developer tooling, computer vision, and systems. Each includes its context, implementation, and current limitations.'
          : '從協作工具、影像處理到系統程式。除了實作，也整理問題背景、技術選擇與目前的限制。'}
      </p>
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>
    </section>
    {notes.length > 0 && (
      <section class="home-notes" aria-labelledby="notes-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">FROM THE NOTEBOOK</p>
            <h2 id="notes-title">{en ? 'Learning notes' : '學習筆記'}</h2>
          </div>
          <a class="text-link" href={pathFor(lang, 'notes')}>
            {t.allNotes}
          </a>
        </div>
        <div class="note-list">
          {notes.map((note) => (
            <NoteCard note={note} lang={lang} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
