---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteCard from '../components/NoteCard.astro';
import { entries } from '../lib/content';
import { ui, pathFor, otherLocale, type Locale } from '../lib/i18n';
import { profile } from '../data/portfolio';
const { lang } = Astro.props as { lang: Locale };
const en = lang === 'en';
const projects = (await entries('projects', lang))
  .filter((p) => p.data.tier === 'featured')
  .slice(0, 4);
const notes = (await entries('notes', lang))
  .sort(
    (a, b) =>
      (b.data.pubDate?.getTime() || 0) - (a.data.pubDate?.getTime() || 0) ||
      a.data.order - b.data.order,
  )
  .slice(0, 3);
const t = ui[lang];
const description = en
  ? 'Computer Science student interested in computer architecture, digital hardware, and applied AI. Projects, experiments, and technical notes by YunHsi Lee.'
  : 'YunHsi Lee 的個人網站。資訊工程學生，關注電腦架構、數位硬體與人工智慧應用，記錄專案、實驗與技術學習。';
---

<BaseLayout
  title={`YunHsi Lee — ${en ? 'Projects & Technical Notes' : '專案與技術筆記'}`}
  description={description}
  lang={lang}
  alternate={pathFor(otherLocale(lang))}
>
  <div class="shell">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow">COMPUTER SCIENCE STUDENT · PERSONAL PORTFOLIO</p>
        <h1 id="intro-title">
          {en ? (
            <>
              Learning how
              <br />
              systems <em>work.</em>
            </>
          ) : (
            <>
              從理解原理，
              <br />
              到動手<em>實作。</em>
            </>
          )}
        </h1>
        <p class="hero-intro">
          {en
            ? 'I’m YunHsi Lee, a Computer Science student at National Sun Yat-sen University. I’m interested in computer architecture, digital hardware, and applied AI.'
            : '我是 YunHsi Lee，目前就讀國立中山大學資訊工程學系全英學士班，對電腦架構、數位硬體與人工智慧應用有興趣。'}
        </p>
        <p class="hero-sub">
          {en
            ? 'This is where I document projects, experiments, and the things I learn along the way.'
            : '這裡記錄我的專案、實驗，以及在學習過程中逐漸想清楚的事。'}
        </p>
        <div class="hero-links">
          <a class="button" href={pathFor(lang, 'projects')}>
            {t.allProjects}
          </a>
          <a class="quiet-link" href={pathFor(lang, 'about')}>
            {en ? 'A little about me' : '關於我'}
          </a>
          <a class="quiet-link" href={profile.github}>
            GitHub
          </a>
        </div>
      </div>
      <aside class="interest-index" aria-labelledby="interest-title">
        <p class="eyebrow" id="interest-title">
          CURRENT FOCUS
        </p>
        <div class="interest-group">
          <span class="small-label">
            {en ? 'Exploring & learning' : '興趣與學習方向'}
          </span>
          <h2>
            Architecture
            <br /> & digital hardware
          </h2>
          <p>
            Digital Design · FPGA / RTL
            <br />
            RISC-V · Post-Quantum Cryptography
          </p>
        </div>
        <div class="interest-group">
          <span class="small-label">
            {en ? 'Through projects & coursework' : '透過專案與課程實作'}
          </span>
          <h2>
            Vision, tools
            <br /> & systems
          </h2>
          <p>
            Computer Vision · AI Systems
            <br />
            Systems Programming
          </p>
        </div>
        <a class="index-link" href={pathFor(lang, 'notes')}>
          {en ? 'Follow the learning notes' : '閱讀學習筆記'}
        </a>
      </aside>
    </section>
    <section class="home-projects" aria-labelledby="projects-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">SELECTED WORK</p>
          <h2 id="projects-title">{t.featured}</h2>
        </div>
        <a class="text-link" href={pathFor(lang, 'projects')}>
          {t.allProjects}
        </a>
      </div>
      <p class="section-intro">
        {en
          ? 'A few projects in developer tooling, computer vision, and systems. Each includes its context, implementation, and current limitations.'
          : '從協作工具、影像處理到系統程式。除了實作，也整理問題背景、技術選擇與目前的限制。'}
      </p>
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>
    </section>
    {notes.length > 0 && (
      <section class="home-notes" aria-labelledby="notes-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">FROM THE NOTEBOOK</p>
            <h2 id="notes-title">{en ? 'Learning notes' : '學習筆記'}</h2>
          </div>
          <a class="text-link" href={pathFor(lang, 'notes')}>
            {t.allNotes}
          </a>
        </div>
        <div class="note-list">
          {notes.map((note) => (
            <NoteCard note={note} lang={lang} />
          ))}
        </div>
      </section>
    )}
    <section class="home-about">
      <p class="eyebrow">A WORK IN PROGRESS</p>
      <h2>
        {en
          ? 'Building foundations, one project at a time.'
          : '在一次次實作中，慢慢把基礎打穩。'}
      </h2>
      <p>
        {en
          ? 'My current work is mostly software and AI applications. I want to connect that experience with a deeper understanding of architecture and digital hardware.'
          : '目前的實作經驗以軟體與 AI 應用為主。接下來，希望把這些經驗連結到電腦架構與數位硬體，逐步深入數位 IC 相關領域。'}
      </p>
      <a class="text-link" href={pathFor(lang, 'about')}>
        {en ? 'Background & interests' : '學習背景與興趣'}
      </a>
    </section>
  </div>
</BaseLayout>
