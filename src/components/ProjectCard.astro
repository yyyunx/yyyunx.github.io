---
import type { Project } from "../data/portfolio";
type Props = { project: Project };
const { project } = Astro.props;
---

<article class="project-card">
  <div class:list={["project-visual", `visual-${project.visual}`]} aria-hidden="true">
    {project.visual === "vehicle" && <><div class="orientation-line"></div><div class="vehicle-row"><i></i><i></i><i></i><i></i></div><div class="degree-row"><span>0°</span><span>90°</span><span>180°</span><span>270°</span></div></>}
    {project.visual === "fleet" && <><div class="dashboard-side"></div><div class="dashboard-lines"><i></i><i></i><i></i></div><div class="route"><span></span><span></span><span></span></div><div class="fleet-chart"></div></>}
    {project.visual === "inspection" && <><div class="inspect-bar"></div><div class="inspect-image"><i></i></div><div class="inspect-list"><span></span><span></span><span></span></div></>}
  </div>
  <div class="project-content">
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    <ul class="tag-list" aria-label={`${project.title} 使用技術`}>{project.tags.map((tag) => <li>{tag}</li>)}</ul>
    <div class="project-links">
      <!-- TODO: Replace placeholder project URL in src/data/portfolio.ts. -->
      <a href={project.href}>查看專案 <span aria-hidden="true">→</span></a>
      <!-- TODO: Replace placeholder GitHub URL in src/data/portfolio.ts. -->
      <a class="github-link" href={project.githubHref} aria-label={`${project.title} 的 GitHub 程式碼庫`}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2.6a9.5 9.5 0 0 0-3 18.5c.48.1.64-.2.64-.45v-1.7c-2.62.57-3.17-1.11-3.17-1.11-.43-1.1-1.04-1.39-1.04-1.39-.85-.58.06-.57.06-.57.94.07 1.43.97 1.43.97.84 1.42 2.2 1.01 2.74.77.08-.61.33-1.02.6-1.26-2.1-.24-4.31-1.05-4.31-4.68 0-1.03.37-1.87.98-2.54-.1-.24-.43-1.21.1-2.52 0 0 .8-.26 2.61.97A9.1 9.1 0 0 1 12 7.1a9 9 0 0 1 2.38.32c1.82-1.23 2.62-.97 2.62-.97.52 1.31.19 2.28.1 2.52.6.67.97 1.51.97 2.54 0 3.64-2.21 4.43-4.32 4.67.34.3.64.88.64 1.77v2.63c0 .25.17.55.65.45A9.5 9.5 0 0 0 12 2.6Z" fill="currentColor" /></svg></a>
    </div>
  </div>
</article>
