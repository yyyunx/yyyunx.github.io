---
import type { CollectionEntry } from 'astro:content';
import { entryUrl } from '../lib/content';
import { categories, statuses, type Locale } from '../lib/i18n';
interface Props {
  project: CollectionEntry<'projects'>;
  lang: Locale;
  compact?: boolean;
}
const { project, lang, compact = false } = Astro.props;
const p = project.data;
---

<article class:list={['project-card', { compact }]}>
  <div class="project-topline">
    <span>{categories[p.category][lang]}</span>
    <span class="status">{statuses[p.status][lang]}</span>
  </div>
  <h3>
    <a href={entryUrl(project)}>{p.title}</a>
  </h3>
  <p>{p.description}</p>
  <ul class="tags" aria-label={lang === 'en' ? 'Technologies' : '相關技術'}>
    {p.tags.map((tag) => (
      <li>{tag}</li>
    ))}
  </ul>
  <div class="project-links">
    <a href={entryUrl(project)}>
      {lang === 'en' ? 'Project notes' : '專案紀錄'}
    </a>
    <a href={p.repository}>GitHub</a>
    {p.demo && <a href={p.demo}>Demo</a>}
  </div>
</article>
