---
import type { CollectionEntry } from 'astro:content';
import { entryUrl } from '../lib/content';
import type { Locale } from '../lib/i18n';
const { note, lang } = Astro.props as {
  note: CollectionEntry<'notes'>;
  lang: Locale;
};
---

<article class="note-row">
  <div class="note-meta">
    <span>{note.data.category}</span>
    {note.data.pubDate && (
      <time datetime={note.data.pubDate.toISOString()}>
        {new Intl.DateTimeFormat(lang === 'en' ? 'en' : 'zh-TW', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          timeZone: 'Asia/Taipei',
        }).format(note.data.pubDate)}
      </time>
    )}
  </div>
  <div>
    <h3>
      <a href={entryUrl(note)}>{note.data.title}</a>
    </h3>
    <p>{note.data.description}</p>
  </div>
</article>
