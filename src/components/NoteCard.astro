---
import type { Note } from "../data/portfolio";

type Props = { note: Note };
const { note } = Astro.props;
---

<article class="note-card">
  <div class:list={["note-visual", note.visual]} aria-hidden="true">
    {note.visual === "exif" && <><b>EXIF</b><i>ORIENTATION</i><span></span></>}
    {note.visual === "runnable" && <><span>Runnable</span><i>LLM</i><b>Output</b></>}
    {note.visual === "terrain" && <><i></i><b></b><span></span></>}
  </div>
  <div class="note-content">
    <p class="note-category">{note.category}</p>
    <h3>{note.title}</h3>
    <p>{note.description}</p>
    <a href={note.href}>閱讀筆記 <span aria-hidden="true">→</span></a>
  </div>
</article>
