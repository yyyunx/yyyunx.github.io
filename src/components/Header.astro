---
import { profile } from "../data/portfolio";
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${profile.name} 首頁`}>{profile.name}</a>
    <nav class="main-nav" aria-label="主要導覽">
      <a href="/#projects">專案</a>
      <a href="/#notes">筆記</a>
      <a href="/#about">關於我</a>
      <!-- TODO: Link this to the final CV document once public/cv.pdf is available. -->
      <a href="/cv.pdf">CV</a>
    </nav>
    <a class="button button-small contact-button" href="/#contact">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3.5 6.5h17v11h-17zM4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" /></svg>
      聯絡我
    </a>
  </div>
</header>
