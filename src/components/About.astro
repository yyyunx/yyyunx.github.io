---
import { milestones, profile } from "../data/portfolio";
---

<section class="section about-section" id="about" aria-labelledby="about-heading">
  <div class="shell"><div class="section-heading"><div><p class="section-kicker">ABOUT ME</p><h2 id="about-heading">ABOUT ME</h2></div></div>
    <div class="about-grid"><div class="about-profile"><div class="avatar" aria-label="姓名縮寫頭像"><span>YL</span></div><div><p>{profile.bio}</p><p class="about-secondary">平常接觸的方向包含電腦視覺、AI 應用、Web 開發與資料處理。我喜歡從實際做專案的過程中理解新的技術，也會把學到的內容整理成筆記，持續補足自己的基礎與實作能力。</p><ul class="profile-details"><li><span aria-hidden="true">⌖</span>{profile.location}</li><li><span aria-hidden="true">✦</span>學歷 — 國立中山大學 資訊工程學系全英學士班｜大三</li></ul></div></div>
      <ol class="timeline">{milestones.map((milestone, index) => <li><span class="timeline-icon">{["⌘", "✦", "↗", "⌁"][index]}</span><div><h3>{milestone.label}</h3><p>{milestone.detail}</p></div></li>)}</ol>
    </div>
  </div>
</section>
