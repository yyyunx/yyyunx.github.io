---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import NoteCard from "../../components/NoteCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="研究與技術筆記 | YunHsi Lee" description="YunHsi Lee 關於 AI、電腦視覺與資料系統的研究及技術筆記。">
  <Header />
  <main class="notes-page">
    <div class="shell">
      <a class="back-link" href="/">← 返回首頁</a>
      <header class="page-heading">
        <p class="section-kicker">公開筆記</p>
        <h1>NOTES</h1>
        <p>整理 AI、電腦視覺與資料系統實作過程中的觀察與技術脈絡。</p>
      </header>
      <div class="notes-grid notes-page-grid">
        {notes.map((note) => <NoteCard note={note} />)}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
